# Copy to .env and fill in. docker compose reads .env automatically.

# Public origin the browser uses (the reverse proxy). Use https in production.
PUBLIC_BASE_URL=http://localhost:8080
# Host port for the reverse proxy (keep in sync with PUBLIC_BASE_URL).
PROXY_PORT=8080
# host:port of the Expo dev server as seen from the proxy container.
FRONTEND_UPSTREAM=host.docker.internal:8081
# host:port of the backend as seen from the proxy. Default is the compose service; when running
# the backend with `cargo run` on the host, point this at the host (e.g. the WSL eth0 IP:8090).
BACKEND_UPSTREAM=backend:8090

# Postgres
POSTGRES_DB=selfstudy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend settings (Entra ID, ...) live in backend/.env; see backend/example.env.
