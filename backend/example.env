# Backend configuration. Copy to `.env` (same folder) and fill in.
# `cargo run` loads backend/.env automatically; docker compose also reads it for the backend
# service and overrides the container-specific values (DATABASE_URL, S3_ENDPOINT, ...).

BIND=0.0.0.0:8090
RUST_LOG=info,backend=debug

# Postgres (docker compose publishes it on localhost:5432).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/selfstudy

# Public origin the browser uses: the reverse proxy, not the backend itself.
PUBLIC_BASE_URL=http://localhost:8080

# Microsoft Entra ID app registration (single tenant).
#   Redirect URI (Web platform): ${PUBLIC_BASE_URL}/api/auth/callback
#   App role for Hub staff:      Marketplace.Admin
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=
# Skips Microsoft's account-type picker, e.g. the school's email domain.
ENTRA_DOMAIN_HINT=
ENTRA_ADMIN_ROLE=Marketplace.Admin

# Where the native app may be sent back to after sign-in (comma separated).
# Add your Expo Go URL while developing, e.g. exp://192.168.1.10:8081/--/auth
APP_REDIRECT_URIS=eduvosmarket://auth

# Object storage (MinIO). Must match the MinIO credentials in the root .env.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=media
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-please

# PayFast. Sandbox credentials: https://sandbox.payfast.co.za (Settings > Integration)
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# PayFast must reach the ITN endpoint over the internet. Locally, run a tunnel
# (e.g. `cloudflared tunnel --url http://localhost:8080`) and put its URL here.
PAYFAST_NOTIFY_BASE_URL=
